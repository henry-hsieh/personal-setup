{
  "$schema": "schema.json",
  "autoupdate": false,
  "agent": {
    "general": {
      "disable": true
    }
  },
  "compaction": {
    "auto": false,
    "prune": false
  },
  "plugin": [
    "@cortexkit/opencode-magic-context@0.42.5",
    "@cortexkit/aft-opencode@0.56.1",
    "@hueyexe/opencode-ensemble@0.18.0",
    "@bybrawe/opencode-goal@1.3.31",
    "@bybrawe/opencode-loop@0.5.36",
    [
      "./plugins/wait/opencode-wait.ts",
      {}
    ],
    [
      "./plugins/pca/opencode-pca.ts",
      {
        "strategy": "merge",
        "enabled": true
      }
    ],
    [
      "./plugins/kata/kata.ts",
      {}
    ]
  ],
  "permission": {
    "external_directory": {
      "~/.local/share/opencode/worktree/**": "allow"
    }
  },
  "lsp": {
    "slang-server": {
      "command": ["slang-server"],
      "extensions": [".v", ".sv", ".vh", ".svh", ".sva"]
    },
    "pyright": {
      "disabled": true
    },
    "ruff": {
      "command": ["ruff", "server"],
      "extensions": [".py", ".pyi"]
    },
    "ty": {
      "command": ["ty", "server"],
      "extensions": [".py", ".pyi"]
    }
  }
}
