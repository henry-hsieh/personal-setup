{
  "$schema": "schema.json",
  "autoupdate": false,
  "agent": {
    "general": {
      "disable": true
    }
  },
  "compaction": {
    "auto": false,
    "prune": false
  },
  "plugin": [
    "@cortexkit/opencode-magic-context@0.37.0",
    "@cortexkit/aft-opencode@0.50.1",
    [
      "./plugins/opencode-pca.ts",
      {
        "strategy": "merge",
        "enabled": true
      }
    ]
  ],
  "lsp": {
    "slang-server": {
      "command": ["slang-server"],
      "extensions": [".v", ".sv", ".vh", ".svh", ".sva"]
    },
    "pyright": {
      "disabled": true
    },
    "ruff": {
      "command": ["ruff", "server"],
      "extensions": [".py", ".pyi"]
    },
    "ty": {
      "command": ["ty", "server"],
      "extensions": [".py", ".pyi"]
    }
  }
}
