{
  "$schema": "schema.json",
  "update": "disable",
  "agents": {
    "general": {
      "disabled": true
    }
  },
  "compaction": {
    "auto": false
  },
  "plugins": [
    "@cortexkit/opencode-magic-context@0.49.31",
    "@cortexkit/aft-opencode@0.62.0",
    "@hueyexe/opencode-ensemble@0.20.0",
    "@bybrawe/opencode-goal@1.3.49",
    "@bybrawe/opencode-loop@0.6.9",
    {
      "package": "./plugins/wait"
    },
    {
      "package": "./plugins/pca",
      "options": {
        "strategy": "merge",
        "enabled": true
      }
    },
    {
      "package": "./plugins/kata"
    }
  ],
  "permissions": [
    {
      "action": "external_directory",
      "resource": "{env:CARGO_HOME}/registry/**",
      "effect": "allow"
    },
    {
      "action": "external_directory",
      "resource": "~/.local/share/opencode/worktree/*",
      "effect": "allow"
    },
    {
      "action": "external_directory",
      "resource": "{env:AFT_STORAGE_DIR}/opencode/bash-tasks/*",
      "effect": "allow"
    },
    {
      "action": "external_directory",
      "resource": "{env:XDG_DATA_HOME}/cortexkit/aft/opencode/bash-tasks/*",
      "effect": "allow"
    },
    {
      "action": "external_directory",
      "resource": "~/.local/share/cortexkit/aft/opencode/bash-tasks/*",
      "effect": "allow"
    }
  ],
  "lsp": {
    "slang-server": {
      "command": ["slang-server"],
      "extensions": [".v", ".sv", ".vh", ".svh", ".sva"]
    },
    "pyright": {
      "disabled": true
    },
    "ruff": {
      "command": ["ruff", "server"],
      "extensions": [".py", ".pyi"]
    },
    "ty": {
      "command": ["ty", "server"],
      "extensions": [".py", ".pyi"]
    }
  }
}
